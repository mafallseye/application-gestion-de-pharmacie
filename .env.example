# Copier ce fichier en .env.local et renseigner les valeurs du projet Supabase
# (Project Settings > API). La clé publiable est faite pour le navigateur :
# ce sont les règles d'accès de la base (RLS) qui protègent les données.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
